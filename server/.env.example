# Keep real values only in the ignored .env file. Never commit credentials.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
PORT=5000
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Optional: use system DNS instead of the existing project's public resolvers.
# DNS_SERVERS=system
# Production must use HTTPS and NODE_ENV=production for Secure session cookies.
# NODE_ENV=production
# TRUST_PROXY=1  # Only behind exactly one trusted reverse proxy.
